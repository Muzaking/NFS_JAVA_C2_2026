# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and replace the placeholder values.
# ==============================================================================

# ------------------------------------------------------------
# Application Ports
# ------------------------------------------------------------
FRONTEND_PORT=5173
BACKEND_PORT=8080
MONGO_HOST_PORT=27018

# ------------------------------------------------------------
# Spring Boot Configuration
# ------------------------------------------------------------
SPRING_PROFILES_ACTIVE=docker

# ------------------------------------------------------------
# JWT Configuration
# ------------------------------------------------------------
# MUST be at least 32 characters. Generate a secure key: $(openssl rand -base64 32)
APP_JWT_SECRET=replace-with-a-long-random-local-dev-secret-at-least-32-characters
APP_JWT_EXPIRATION_MINUTES=60

# ------------------------------------------------------------
# MongoDB Initial Setup (If securing the database)
# ------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=replace-with-local-root-password
MONGO_INITDB_DATABASE=asset_tracker_db

# Application Specific Database User
MONGO_APP_USERNAME=asset_app
MONGO_APP_PASSWORD=replace-with-local-app-password
MONGO_APP_DATABASE=asset_tracker_db